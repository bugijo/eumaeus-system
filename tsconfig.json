{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "supertest": ["./backend/test-utils/mockSupertest"],
      "express": ["./backend/test-utils/stubs/express"],
      "compression": ["./backend/test-utils/stubs/compression"],
      "cors": ["./backend/test-utils/stubs/cors"],
      "node-cron": ["./backend/test-utils/stubs/node-cron"],
      "nodemailer": ["./backend/test-utils/stubs/nodemailer"]
