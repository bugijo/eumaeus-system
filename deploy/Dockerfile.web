# Frontend Eumaeus (Vite) servido pelo Caddy, que também faz HTTPS e proxy da API.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Vazio = mesma origem (/api), atendido pelo Caddy.
ENV VITE_API_URL=""
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
