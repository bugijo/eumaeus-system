# Copiar para deploy/.env NA VPS (nunca commitar). Gerar segredos com: openssl rand -hex 32
POSTGRES_PASSWORD=<gerar com openssl rand -hex 24>
JWT_SECRET=<gerar com openssl rand -hex 32>
REFRESH_TOKEN_SECRET=<gerar com openssl rand -hex 32, diferente do anterior>
# Proxies confiáveis (Caddy na mesma rede do docker). Padrão seguro; só mude se souber a topologia.
TRUST_PROXY=loopback, linklocal, uniquelocal
SITE_ADDRESS=eumaeus.com.br
WWW_ADDRESS=www.eumaeus.com.br
PRIMARY_HOST=eumaeus.com.br
# Opcional (e-mails do sistema)
EMAIL_USER=
EMAIL_PASSWORD=

# SMTP para e-mails (confirmação de cadastro, link pós-pagamento). Sem isto, a conta nasce confirmada.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=

# Mercado Pago: credenciais do painel developers (aplicação Eumaeus). Nunca versionar os valores.
MP_ACCESS_TOKEN=
# Chave secreta do webhook (painel > Webhooks). Com ela, notificações sem assinatura válida são recusadas.
MP_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://eumaeus.com.br
