# Copiar para deploy/.env NA VPS (nunca commitar). Gerar segredos com: openssl rand -hex 32
POSTGRES_PASSWORD=<gerar com openssl rand -hex 24>
JWT_SECRET=<gerar com openssl rand -hex 32>
REFRESH_TOKEN_SECRET=<gerar com openssl rand -hex 32, diferente do anterior>
SITE_ADDRESS=eumaeus.com.br
WWW_ADDRESS=www.eumaeus.com.br
PRIMARY_HOST=eumaeus.com.br
# Opcional (e-mails do sistema)
EMAIL_USER=
EMAIL_PASSWORD=
