# Backend Eumaeus (Express + Prisma) para a VPS.
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund
COPY backend/ ./
RUN npx prisma generate && npm run build && npm prune --omit=dev && npx prisma generate

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=3333
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl fonts-dejavu-core fonts-liberation tini \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/prisma ./prisma
USER node
EXPOSE 3333
# Aplica migrations pendentes antes de subir; falha de migration impede a subida.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/src/bootstrap.js"]
