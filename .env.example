# Database (obrigatório; apenas PostgreSQL)
DATABASE_URL="postgresql://db_user:replace-with-password@localhost:5432/eumaeus"

# JWT (obrigatórios; gere valores aleatórios, distintos e com pelo menos 32 caracteres)
JWT_SECRET="<generate-a-random-access-secret>"
REFRESH_TOKEN_SECRET="<generate-a-different-random-refresh-secret>"

# Server
PORT=5000
NODE_ENV=development

# === MÓDULO FISCAL - NFS-E ===
# Focus NFe Configuration
# Obtenha seu token em: https://focusnfe.com.br
FOCUS_NFE_TOKEN="your-focus-nfe-token-here"

# Ambiente: 'sandbox' para testes, 'production' para produção
NFE_ENVIRONMENT="sandbox"

# Dados da Empresa (obrigatórios para emissão de NFS-e)
EMPRESA_CNPJ="00.000.000/0001-00"
EMPRESA_INSCRICAO_MUNICIPAL="123456"
EMPRESA_CODIGO_MUNICIPIO="3543402"

# Exemplo de configuração para Ribeirão Preto-SP:
# EMPRESA_CODIGO_MUNICIPIO="3543402"
# Para outros municípios, consulte: https://www.ibge.gov.br/explica/codigos-dos-municipios.php

# === CONFIGURAÇÕES OPCIONAIS ===
# Configurações de email (para futuras funcionalidades)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# Configurações de storage (para futuras funcionalidades)
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-bucket-name"
