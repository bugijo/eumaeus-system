{
  "name": "eumaeus-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Instalador desktop do Eumaeus (carrega o sistema publicado em eumaeus.com.br)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "br.com.eumaeus.desktop",
    "productName": "Eumaeus",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Eumaeus-windows.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "artifactName": "Eumaeus-macos.${ext}"
    },
    "artifactName": "Eumaeus-${os}.${ext}"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
