# Configurações do Banco de Dados (obrigatório; apenas PostgreSQL)
DATABASE_URL="postgresql://db_user:replace-with-password@localhost:5432/eumaeus"

# Configurações de Autenticação (valores aleatórios, distintos e com pelo menos 32 caracteres)
JWT_SECRET="<generate-a-random-access-secret>"
REFRESH_TOKEN_SECRET="<generate-a-different-random-refresh-secret>"

# Configurações do Servidor
PORT=3333
NODE_ENV=development

# Configurações de E-mail para Lembretes Automáticos
# ================================================
# Para usar Gmail, você precisa:
# 1. Ativar a verificação em duas etapas na sua conta Google
# 2. Gerar uma "Senha de App" específica para esta aplicação
# 3. Usar a senha de app no lugar da sua senha normal

# E-mail que enviará os lembretes
EMAIL_USER="seu-email@gmail.com"

# Senha de app do Gmail (NÃO use sua senha normal!)
EMAIL_PASSWORD="sua-senha-de-app-do-gmail"

# Configurações opcionais para outros provedores de e-mail
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Configurações da Clínica (usadas nos e-mails)
CLINIC_NAME="Eumaeus Clínica Veterinária"
CLINIC_PHONE="(11) 99999-9999"
CLINIC_EMAIL="contato@eumaeus.com.br"
CLINIC_ADDRESS="Rua das Flores, 123 - São Paulo, SP"
